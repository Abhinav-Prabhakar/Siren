# LLM chat (POST /api/chat) — OpenAI-compatible endpoint
# Without VOIDAI_API_KEY the chat endpoint returns 503.
VOIDAI_API_KEY=
VOIDAI_BASE_URL=
VOIDAI_MODEL=gpt-5-nano

# Vapi (vapi.ai) voice-agent integration — see server/vapi/README.md
# Private API key from https://dashboard.vapi.ai → API Keys
VAPI_API_KEY=
# Public webhook URL pointing at this backend (e.g. an ngrok tunnel)
VAPI_SERVER_URL=https://<your-tunnel>/api/vapi/webhook
# Optional shared secret checked on incoming webhooks
# (x-vapi-secret header via assistant.serverUrlSecret, or Authorization: Bearer via credentialId)
VAPI_WEBHOOK_SECRET=
